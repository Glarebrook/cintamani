; Godot 프로젝트 설정 파일입니다.
; 보통은 Godot 에디터의 [프로젝트 > 프로젝트 설정] 메뉴에서 바꾸고, 직접 손으로 고칠 일은 거의 없습니다.

config_version=5

[application]

config/name="이무기 (가제)"
config/description="뱀이 용이 되어 가는 게임"
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Data="*res://autoload/data_db.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

